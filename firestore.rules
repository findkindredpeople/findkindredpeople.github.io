rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function moderator() { return signedIn() && exists(/databases/$(database)/documents/moderators/$(request.auth.uid)); }
    function participant(data) { return signedIn() && request.auth.uid in data.participants; }
    function validProfile() {
      return request.resource.data.keys().hasOnly(['displayName','city','country','bio','interests','languages','availability','friendshipGoal','connectionMode','contactFrequency','socialFormat','communicationStyle','socialEnergy','spontaneousInvites','conversationDepth','newCityRole','timeZone','meetingPace','availableTimes','intercultural','namePronunciation','preferredContactTime','comfortableTopics','culturalContext','photoURL','active','adultConfirmed','updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 50
        && request.resource.data.city is string && request.resource.data.city.size() >= 2 && request.resource.data.city.size() <= 80
        && request.resource.data.country is string && request.resource.data.country.size() >= 2 && request.resource.data.country.size() <= 80
        && request.resource.data.bio is string && request.resource.data.bio.size() >= 30 && request.resource.data.bio.size() <= 500
        && request.resource.data.interests is list && request.resource.data.interests.size() <= 12
        && request.resource.data.languages is list && request.resource.data.languages.size() <= 8
        && request.resource.data.friendshipGoal in ['close','casual','activities']
        && request.resource.data.connectionMode in ['online','offline','both']
        && request.resource.data.contactFrequency in ['daily','fewWeekly','weekly','flexible']
        && request.resource.data.socialFormat in ['one','small','both']
        && request.resource.data.communicationStyle in ['text','voice','calls','mixed']
        && request.resource.data.socialEnergy in ['calm','balanced','lively']
        && request.resource.data.spontaneousInvites in ['yes','no','sometimes']
        && request.resource.data.conversationDepth in ['deep','light','both']
        && request.resource.data.newCityRole in ['newcomer','localHelper','either']
        && request.resource.data.timeZone is string && request.resource.data.timeZone.size() <= 80
        && request.resource.data.meetingPace in ['soon','later','travel','onlineOnly']
        && request.resource.data.availableTimes is list && request.resource.data.availableTimes.size() >= 1 && request.resource.data.availableTimes.size() <= 6
        && request.resource.data.availableTimes.hasOnly(['weekdayMorning','weekdayDaytime','weekdayEvening','weekendMorning','weekendDaytime','weekendEvening'])
        && request.resource.data.intercultural is bool
        && request.resource.data.get('namePronunciation', '') is string && request.resource.data.get('namePronunciation', '').size() <= 100
        && request.resource.data.get('preferredContactTime', 'flexible') in ['morning','afternoon','evening','flexible']
        && request.resource.data.get('comfortableTopics', []) is list && request.resource.data.get('comfortableTopics', []).size() <= 10
        && request.resource.data.get('culturalContext', '') is string && request.resource.data.get('culturalContext', '').size() <= 300
        && request.resource.data.active is bool && request.resource.data.adultConfirmed == true;
    }
    function validAgreement(data) {
      return data is map
        && data.keys().hasOnly(['frequency','meeting','format','closeness','voice','spontaneous','boundaries','updatedAt'])
        && data.frequency in ['daily','fewWeekly','weekly','flexible']
        && data.meeting in ['yes','maybe','onlineOnly']
        && data.format in ['text','voice','calls','mixed']
        && data.closeness in ['close','casual','open']
        && data.voice in ['yes','no']
        && data.spontaneous in ['yes','no','sometimes']
        && data.get('boundaries', '') is string
        && data.get('boundaries', '').size() <= 300;
    }
    function validJourney(data) {
      return data is map
        && data.keys().hasOnly(['steps','continueFriendship','updatedAt'])
        && data.steps is list && data.steps.size() == 4
        && data.steps[0] is bool && data.steps[1] is bool
        && data.steps[2] is bool && data.steps[3] is bool
        && (data.continueFriendship == null || data.continueFriendship is bool);
    }
    function validMeetingPlan(data) {
      return data is map
        && data.keys().hasOnly(['mode','activity','when','publicPlace','statusBy'])
        && data.mode in ['online','offline']
        && data.activity is string && data.activity.size() >= 1 && data.activity.size() <= 200
        && data.when is string && data.when.size() >= 10 && data.when.size() <= 50
        && data.publicPlace is string && data.publicPlace.size() <= 160
        && (data.mode == 'online' || data.publicPlace.size() >= 2)
        && data.statusBy is map
        && data.statusBy.keys().hasOnly([request.auth.uid])
        && data.statusBy[request.auth.uid] == 'accepted';
    }
    function validVideoCall(data) {
      return data is map
        && data.keys().hasOnly(['roomUrl','status','createdBy','respondedBy','respondedAt'])
        && data.roomUrl is string
        && data.roomUrl.matches('https://meet\\.jit\\.si/kindred-[A-Za-z0-9-]{20,80}')
        && data.status == 'ringing'
        && data.createdBy == request.auth.uid
        && data.respondedBy == '' && data.respondedAt == '';
    }
    function connection(id) { return get(/databases/$(database)/documents/connections/$(id)).data; }
    function notBlocked(data) {
      return !exists(/databases/$(database)/documents/blocks/$(data.participants[0] + '_' + data.participants[1]))
        && !exists(/databases/$(database)/documents/blocks/$(data.participants[1] + '_' + data.participants[0]));
    }

    match /users/{uid} { allow read, create, update, delete: if owner(uid); }
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if owner(uid) && validProfile();
      allow delete: if owner(uid);
    }
    match /connections/{id} {
      allow read: if participant(resource.data);
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['participants','requestedBy','recipientId','status','createdAt','updatedAt'])
        && request.resource.data.participants is list && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.recipientId in request.resource.data.participants
        && (id == request.auth.uid + '_' + request.resource.data.recipientId || id == request.resource.data.recipientId + '_' + request.auth.uid)
        && request.resource.data.status == 'pending';
      allow update: if (signedIn() && request.auth.uid == resource.data.recipientId
        && resource.data.status == 'pending' && request.resource.data.status in ['accepted','declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']))
        || (participant(resource.data) && resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['agreements','updatedAt'])
        && validAgreement(request.resource.data.agreements[request.auth.uid])
        && request.resource.data.agreements.diff(resource.data.get('agreements', {})).affectedKeys().hasOnly([request.auth.uid]))
        || (participant(resource.data) && resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['journeys','updatedAt'])
        && validJourney(request.resource.data.journeys[request.auth.uid])
        && request.resource.data.journeys.diff(resource.data.get('journeys', {})).affectedKeys().hasOnly([request.auth.uid]));
      allow delete: if participant(resource.data);
    }
    match /connections/{connectionId}/messages/{messageId} {
      allow read: if participant(connection(connectionId));
      allow create: if participant(connection(connectionId)) && connection(connectionId).status == 'accepted'
        && notBlocked(connection(connectionId))
        && connection(connectionId).agreements is map
        && connection(connectionId).agreements.keys().hasAll(connection(connectionId).participants)
        && request.resource.data.keys().hasOnly(['senderId','text','audioData','audioType','duration','plan','call','createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.get('text', '') is string
        && ((request.resource.data.get('text', '').size() >= 1 && request.resource.data.get('text', '').size() <= 2000 && request.resource.data.get('audioData', '') == '' && request.resource.data.get('plan', null) == null && request.resource.data.get('call', null) == null)
          || (request.resource.data.get('text', '') == ''
            && request.resource.data.get('audioData', '') is string && request.resource.data.get('audioData', '').size() >= 1 && request.resource.data.get('audioData', '').size() <= 180000
            && request.resource.data.get('audioData', '').matches('data:audio/(webm|mp4|ogg).*;base64,.*')
            && request.resource.data.get('audioType', '') is string && request.resource.data.get('audioType', '').matches('audio/(webm|mp4|ogg).*')
            && request.resource.data.get('duration', 0) is number && request.resource.data.get('duration', 0) > 0 && request.resource.data.get('duration', 0) <= 20
            && request.resource.data.get('plan', null) == null && request.resource.data.get('call', null) == null)
          || (request.resource.data.get('text', '') == '' && request.resource.data.get('audioData', '') == ''
            && validMeetingPlan(request.resource.data.plan) && request.resource.data.get('call', null) == null)
          || (request.resource.data.get('text', '') == '' && request.resource.data.get('audioData', '') == ''
            && request.resource.data.get('plan', null) == null && validVideoCall(request.resource.data.call)));
      allow update: if (participant(connection(connectionId)) && connection(connectionId).status == 'accepted'
        && resource.data.plan is map && request.auth.uid != resource.data.senderId
        && !(request.auth.uid in resource.data.plan.statusBy)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan'])
        && request.resource.data.plan.diff(resource.data.plan).affectedKeys().hasOnly(['statusBy'])
        && request.resource.data.plan.statusBy.diff(resource.data.plan.statusBy).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.plan.statusBy[request.auth.uid] in ['accepted','declined'])
        || (participant(connection(connectionId)) && connection(connectionId).status == 'accepted'
        && resource.data.call is map && resource.data.call.status == 'ringing'
        && request.auth.uid != resource.data.senderId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['call'])
        && request.resource.data.call.diff(resource.data.call).affectedKeys().hasOnly(['status','respondedBy','respondedAt'])
        && request.resource.data.call.status in ['accepted','declined','missed']
        && request.resource.data.call.respondedBy == request.auth.uid
        && request.resource.data.call.respondedAt is string
        && request.resource.data.call.respondedAt.size() >= 10 && request.resource.data.call.respondedAt.size() <= 50);
      allow delete: if false;
    }
    match /blocks/{id} {
      allow read: if signedIn() && (resource.data.blockerId == request.auth.uid || resource.data.blockedId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId != request.auth.uid
        && request.resource.data.keys().hasOnly(['blockerId','blockedId','createdAt'])
        && id == request.auth.uid + '_' + request.resource.data.blockedId;
      allow delete: if signedIn() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['reporterId','reportedId','reason','details','status','createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedId != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.details is string && request.resource.data.details.size() >= 20 && request.resource.data.details.size() <= 1000
        && request.resource.data.status == 'open';
      allow read: if moderator() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow update: if moderator();
      allow delete: if false;
    }
    match /moderators/{uid} { allow read: if owner(uid); allow write: if false; }
  }
}
