    }

    match /moderators/{uid} { allow read: if owner(uid); allow write: if false; }
    // Kindred online arcade v1. Existing app and website rules are kept above.
    function arcadeRoom(id) { return get(/databases/$(database)/documents/arcadeRooms/$(id)).data; }
    function arcadeMember(id) { return signedIn() && request.auth.uid in arcadeRoom(id).participants; }
    function arcadeShape(d) {
      return d.keys().hasOnly(['gameType','mode','status','player1Id','player1Name','player2Id','player2Name','participants','connectionId','state','rematchRequestedBy','round','createdAt','updatedAt','heartbeatAt','seriesTarget','wins1','wins2','seriesRound'])
        && d.gameType in ['tic_tac_toe','connect_four','memory','checkers'] && d.mode in ['random','invite']
        && d.status in ['waiting','invited','playing','finished','cancelled','declined']
        && d.player1Id is string && d.player1Id.size() >= 1 && d.player1Id.size() <= 128
        && d.player2Id is string && d.player2Id.size() <= 128
        && d.player1Name is string && d.player1Name.size() >= 1 && d.player1Name.size() <= 80
        && d.player2Name is string && d.player2Name.size() <= 80
        && d.participants is list && d.participants.size() >= 1 && d.participants.size() <= 2
        && d.connectionId is string && d.connectionId.size() <= 256
        && d.rematchRequestedBy is string && d.round is int && d.round >= 1 && arcadeSeriesShape(d)
        && d.createdAt is timestamp && d.updatedAt is timestamp && d.heartbeatAt is timestamp
        && d.state is map && d.state.keys().hasOnly(['board','tokens1','tokens2','deck','matched','firstCard','secondCard','score1','score2','turn','winner','lastMove','moveCount'].concat(d.gameType == 'checkers' ? ['kings','forcedFrom','quietMoves','lastFrom','lastCaptured'] : []))
        && d.state.board is map && d.state.tokens1 is list && d.state.tokens2 is list && d.state.deck is list && d.state.matched is list
        && d.state.firstCard is int && d.state.secondCard is int
        && d.state.score1 is int && d.state.score2 is int
        && d.state.turn is int && d.state.turn in [1,2] && d.state.winner is int && d.state.winner in [0,1,2,3]
        && d.state.lastMove is int && d.state.moveCount is int;
    }
    // Optional first-to-three series. Legacy single rounds keep their original shape.
    function arcadeSeriesShape(d) {
      return (d.get('seriesTarget',1) == 1 && !d.keys().hasAny(['seriesTarget','wins1','wins2','seriesRound']))
        || (d.seriesTarget == 3 && d.wins1 is int && d.wins2 is int && d.seriesRound is int
          && d.wins1 >= 0 && d.wins1 <= 3 && d.wins2 >= 0 && d.wins2 <= 3 && d.seriesRound >= 1);
    }
    function arcadeSeriesAward(o,n) {
      return o.get('seriesTarget',1) == 3
        ? (o.wins1 < 3 && o.wins2 < 3
          && n.wins1 == o.wins1 + (n.state.winner == 1 ? 1 : 0)
          && n.wins2 == o.wins2 + (n.state.winner == 2 ? 1 : 0))
        : !n.diff(o).affectedKeys().hasAny(['wins1','wins2']);
    }
    function arcadeSeriesNext(o,n) {
      return o.get('seriesTarget',1) == 3
        ? (n.wins1 == (o.wins1 == 3 || o.wins2 == 3 ? 0 : o.wins1)
          && n.wins2 == (o.wins1 == 3 || o.wins2 == 3 ? 0 : o.wins2)
          && n.seriesRound == (o.wins1 == 3 || o.wins2 == 3 ? 1 : o.seriesRound+1))
        : !n.diff(o).affectedKeys().hasAny(['wins1','wins2','seriesRound']);
    }
    function checkersCapture(board,kings,c,me) {
      return ((me == 1 || c in kings) && c >= 16
          && ((c % 8 >= 2 && board.get(string(c-9),0) == 3-me && board.get(string(c-18),0) == 0)
            || (c % 8 <= 5 && board.get(string(c-7),0) == 3-me && board.get(string(c-14),0) == 0)))
        || ((me == 2 || c in kings) && c < 48
          && ((c % 8 >= 2 && board.get(string(c+7),0) == 3-me && board.get(string(c+14),0) == 0)
            || (c % 8 <= 5 && board.get(string(c+9),0) == 3-me && board.get(string(c+18),0) == 0)));
    }
    function checkersStep(board,kings,c,me) {
      return ((me == 1 || c in kings) && c >= 8
          && ((c % 8 >= 1 && board.get(string(c-9),0) == 0) || (c % 8 <= 6 && board.get(string(c-7),0) == 0)))
        || ((me == 2 || c in kings) && c < 56
          && ((c % 8 >= 1 && board.get(string(c+7),0) == 0) || (c % 8 <= 6 && board.get(string(c+9),0) == 0)));
    }
    function checkersCanAct(board,kings,c,me,capturesOnly) {
      return (!capturesOnly && checkersStep(board,kings,c,me)) || checkersCapture(board,kings,c,me);
    }
    function checkersAny(board,kings,tokens,me,capturesOnly) {
      return (tokens.size() > 0 && checkersCanAct(board,kings,tokens[0],me,capturesOnly))
        || (tokens.size() > 1 && checkersCanAct(board,kings,tokens[1],me,capturesOnly))
        || (tokens.size() > 2 && checkersCanAct(board,kings,tokens[2],me,capturesOnly))
        || (tokens.size() > 3 && checkersCanAct(board,kings,tokens[3],me,capturesOnly))
        || (tokens.size() > 4 && checkersCanAct(board,kings,tokens[4],me,capturesOnly))
        || (tokens.size() > 5 && checkersCanAct(board,kings,tokens[5],me,capturesOnly))
        || (tokens.size() > 6 && checkersCanAct(board,kings,tokens[6],me,capturesOnly))
        || (tokens.size() > 7 && checkersCanAct(board,kings,tokens[7],me,capturesOnly))
        || (tokens.size() > 8 && checkersCanAct(board,kings,tokens[8],me,capturesOnly))
        || (tokens.size() > 9 && checkersCanAct(board,kings,tokens[9],me,capturesOnly))
        || (tokens.size() > 10 && checkersCanAct(board,kings,tokens[10],me,capturesOnly))
        || (tokens.size() > 11 && checkersCanAct(board,kings,tokens[11],me,capturesOnly));
    }
    function checkersDiagonal(f,t,distance) {
      return (int(t/8) == int(f/8)+distance || int(t/8) == int(f/8)-distance)
        && (t%8 == f%8+distance || t%8 == f%8-distance);
    }
    function checkersGeometry(a,b) {
      let f = b.lastFrom;
      let t = b.lastMove;
      let capture = b.lastCaptured >= 0;
      return f is int && t is int && f >= 0 && f < 64 && t >= 0 && t < 64
        && a.board.get(string(f),0) == a.turn && a.board.get(string(t),0) == 0
        && (f in a.kings || (a.turn == 1 ? t < f : t > f))
        && (capture ? (checkersDiagonal(f,t,2) && b.lastCaptured == int((f+t)/2)
            && a.board.get(string(b.lastCaptured),0) == 3-a.turn) : checkersDiagonal(f,t,1))
        && (a.forcedFrom >= 0 ? (capture && f == a.forcedFrom)
          : (capture || !checkersAny(a.board,a.kings,a.turn == 1 ? a.tokens1 : a.tokens2,a.turn,true)));
    }
    function checkersBoardUpdate(a,b) {
      let f = b.lastFrom;
      let t = b.lastMove;
      let cap = b.lastCaptured;
      let own = a.turn == 1 ? a.tokens1 : a.tokens2;
      let nextOwn = a.turn == 1 ? b.tokens1 : b.tokens2;
      let other = a.turn == 1 ? a.tokens2 : a.tokens1;
      let nextOther = a.turn == 1 ? b.tokens2 : b.tokens1;
      return b.board.size() == a.board.size()-(cap >= 0 ? 1 : 0)
        && b.board.diff(a.board).affectedKeys() == (cap >= 0 ? [string(f),string(t),string(cap)] : [string(f),string(t)]).toSet()
        && !b.board.keys().hasAny([string(f)]) && b.board[string(t)] == a.turn
        && (cap < 0 || !b.board.keys().hasAny([string(cap)]))
        && nextOwn.size() == own.size() && nextOwn.toSet() == own.removeAll([f]).concat([t]).toSet()
        && nextOther.size() == other.size()-(cap >= 0 ? 1 : 0) && nextOther.toSet() == other.removeAll([cap]).toSet();
    }
    function checkersPromotes(a,b) {
      return !(b.lastFrom in a.kings) && (a.turn == 1 ? b.lastMove < 8 : b.lastMove >= 56);
    }
    function checkersMetadata(a,b) {
      let crowned = b.lastFrom in a.kings || checkersPromotes(a,b);
      return b.kings is list && b.forcedFrom is int && b.quietMoves is int && b.lastCaptured is int && b.lastCaptured >= -1
        && b.kings.size() == b.kings.toSet().size()
        && b.kings.toSet() == a.kings.removeAll([b.lastFrom,b.lastCaptured]).concat(crowned ? [b.lastMove] : []).toSet()
        && b.quietMoves == (b.lastFrom in a.kings && b.lastCaptured == -1 ? a.quietMoves+1 : 0)
        && b.moveCount == a.moveCount+1
        && b.diff(a).affectedKeys().hasOnly(['board','tokens1','tokens2','kings','forcedFrom','quietMoves','lastFrom','lastCaptured','lastMove','moveCount','turn','winner']);
    }
    function checkersOutcome(o,n) {
      let a = o.state;
      let b = n.state;
      let chain = b.lastCaptured >= 0 && !checkersPromotes(a,b) && checkersCapture(b.board,b.kings,b.lastMove,a.turn);
      let otherCanPlay = chain || checkersAny(b.board,b.kings,a.turn == 1 ? b.tokens2 : b.tokens1,3-a.turn,false);
      let winner = chain ? 0 : (!otherCanPlay ? a.turn : (b.quietMoves >= 80 ? 3 : 0));
      return b.forcedFrom == (chain ? b.lastMove : -1) && b.winner == winner
        && b.turn == (chain || winner != 0 ? a.turn : 3-a.turn)
        && n.status == (winner == 0 ? 'playing' : 'finished');
    }
    function checkersMove(o,n) {
      return checkersGeometry(o.state,n.state) && checkersBoardUpdate(o.state,n.state)
        && checkersMetadata(o.state,n.state) && checkersOutcome(o,n);
    }
    function checkersInitial(s) {
      return s.board == {'1': 2, '3': 2, '5': 2, '7': 2, '8': 2, '10': 2, '12': 2, '14': 2, '17': 2, '19': 2, '21': 2, '23': 2, '40': 1, '42': 1, '44': 1, '46': 1, '49': 1, '51': 1, '53': 1, '55': 1, '56': 1, '58': 1, '60': 1, '62': 1} && s.tokens1 == [40, 42, 44, 46, 49, 51, 53, 55, 56, 58, 60, 62] && s.tokens2 == [1, 3, 5, 7, 8, 10, 12, 14, 17, 19, 21, 23]
        && s.kings == [] && s.forcedFrom == -1 && s.quietMoves == 0 && s.lastFrom == -1 && s.lastCaptured == -1;
    }
    function arcadeInitial(d) {
      return (d.gameType == 'checkers' ? checkersInitial(d.state) : (d.state.board == {} && d.state.tokens1 == [] && d.state.tokens2 == [])) && d.state.matched == []
        && d.state.firstCard == -1 && d.state.secondCard == -1
        && d.state.score1 == 0 && d.state.score2 == 0
        && d.state.turn == (d.get('seriesTarget',1) == 3 && d.round % 2 == 0 ? 2 : 1) && d.state.winner == 0 && d.state.lastMove == -1 && d.state.moveCount == 0
        && ((d.gameType != 'memory' && d.state.deck == [])
          || (d.gameType == 'memory' && d.state.deck.size() == 16
            && d.state.deck.hasOnly([0,1,2,3,4,5,6,7])
            && d.state.deck.removeAll([0]).size() == 14 && d.state.deck.removeAll([1]).size() == 14
            && d.state.deck.removeAll([2]).size() == 14 && d.state.deck.removeAll([3]).size() == 14
            && d.state.deck.removeAll([4]).size() == 14 && d.state.deck.removeAll([5]).size() == 14
            && d.state.deck.removeAll([6]).size() == 14 && d.state.deck.removeAll([7]).size() == 14));
    }
    function arcadeInvite(d) {
      let c = get(/databases/$(database)/documents/connections/$(d.connectionId)).data;
      return c.status == 'accepted' && c.participants.toSet() == d.participants.toSet() && notBlocked(d);
    }
    function arcadeTicWin(cells) {
      return cells.hasAll([0,1,2]) || cells.hasAll([3,4,5]) || cells.hasAll([6,7,8])
        || cells.hasAll([0,3,6]) || cells.hasAll([1,4,7]) || cells.hasAll([2,5,8])
        || cells.hasAll([0,4,8]) || cells.hasAll([2,4,6]);
    }
    function arcadeFourWin(cells,i) {
      let r = int(i / 7);
      let c = i % 7;
      return (c <= 3 && cells.hasAll([i,i+1,i+2,i+3]))
        || (c >= 1 && c <= 4 && cells.hasAll([i-1,i,i+1,i+2]))
        || (c >= 2 && c <= 5 && cells.hasAll([i-2,i-1,i,i+1]))
        || (c >= 3 && cells.hasAll([i-3,i-2,i-1,i]))
        || (r <= 2 && cells.hasAll([i,i+7,i+14,i+21]))
        || (r <= 2 && c <= 3 && cells.hasAll([i,i+8,i+16,i+24]))
        || (r >= 1 && r <= 3 && c >= 1 && c <= 4 && cells.hasAll([i-8,i,i+8,i+16]))
        || (r >= 2 && r <= 4 && c >= 2 && c <= 5 && cells.hasAll([i-16,i-8,i,i+8]))
        || (r >= 3 && c >= 3 && cells.hasAll([i-24,i-16,i-8,i]))
        || (r <= 2 && c >= 3 && cells.hasAll([i,i+6,i+12,i+18]))
        || (r >= 1 && r <= 3 && c >= 2 && c <= 5 && cells.hasAll([i-6,i,i+6,i+12]))
        || (r >= 2 && r <= 4 && c >= 1 && c <= 4 && cells.hasAll([i-12,i-6,i,i+6]))
        || (r >= 3 && c <= 3 && cells.hasAll([i-18,i-12,i-6,i]));
    }
    function arcadeTokenMove(a,b) {
      let before = a.turn == 1 ? a.tokens1 : a.tokens2;
      let after = a.turn == 1 ? b.tokens1 : b.tokens2;
      return after.size() == before.size()+1 && after.hasAll(before) && after.hasAll([b.lastMove])
        && (a.turn == 1 ? b.tokens2 == a.tokens2 : b.tokens1 == a.tokens1);
    }
    function arcadeBoardMove(o,n) {
      let a = o.state;
      let b = n.state;
      let limit = o.gameType == 'tic_tac_toe' ? 9 : 42;
      let cells = a.turn == 1 ? b.tokens1 : b.tokens2;
      let won = o.gameType == 'tic_tac_toe' ? arcadeTicWin(cells) : (cells.size() >= 4 && arcadeFourWin(cells,b.lastMove));
      let result = won ? a.turn : (b.board.size() == limit ? 3 : 0);
      return b.board is map && b.tokens1 is list && b.tokens2 is list && b.lastMove is int && b.moveCount is int
        && b.turn is int && b.winner is int
        && b.diff(a).affectedKeys().hasOnly(['board','tokens1','tokens2','turn','winner','lastMove','moveCount']) && arcadeTokenMove(a,b)
        && b.lastMove >= 0 && b.lastMove < limit
        && !a.board.keys().hasAny([string(b.lastMove)])
        && b.board.size() == a.board.size()+1
        && b.board.diff(a.board).affectedKeys().hasOnly([string(b.lastMove)])
        && b.board[string(b.lastMove)] == a.turn
        && (o.gameType != 'connect_four' || b.lastMove >= 35 || a.board.get(string(b.lastMove+7),0) in [1,2])
        && b.moveCount == a.moveCount+1 && b.winner == result
        && b.turn == (result == 0 ? 3-a.turn : a.turn)
        && n.status == (result == 0 ? 'playing' : 'finished');
    }
    function arcadeMemoryMatch(o,n) {
      let a = o.state;
      let b = n.state;
      let s1 = a.score1 + (a.turn == 1 ? 1 : 0);
      let s2 = a.score2 + (a.turn == 2 ? 1 : 0);
      let result = b.matched.size() != 16 ? 0 : (s1 > s2 ? 1 : (s2 > s1 ? 2 : 3));
      return b.diff(a).affectedKeys().hasOnly(['firstCard','secondCard','matched','score1','score2','winner','lastMove','moveCount'])
        && a.deck[a.firstCard] == a.deck[b.lastMove]
        && b.matched == a.matched.concat([a.firstCard,b.lastMove])
        && b.firstCard == -1 && b.secondCard == -1
        && b.score1 == s1 && b.score2 == s2 && b.winner == result && b.moveCount == a.moveCount+1
        && n.status == (result == 0 ? 'playing' : 'finished');
    }
    function arcadeMemoryMove(o,n) {
      let a = o.state;
      let b = n.state;
      return b.firstCard is int && b.secondCard is int && b.lastMove is int && b.moveCount is int
        && b.score1 is int && b.score2 is int && b.turn is int && b.winner is int && b.matched is list
        && ((a.firstCard >= 0 && a.secondCard >= 0
          && b.diff(a).affectedKeys().hasOnly(['firstCard','secondCard','turn'])
          && b.firstCard == -1 && b.secondCard == -1 && b.turn == 3-a.turn && n.status == 'playing')
        || (a.secondCard == -1 && b.lastMove >= 0 && b.lastMove < 16
          && !(b.lastMove in a.matched) && b.lastMove != a.firstCard
          && ((a.firstCard == -1 && b.firstCard == b.lastMove
                && b.diff(a).affectedKeys().hasOnly(['firstCard','lastMove']) && n.status == 'playing')
            || (a.firstCard >= 0 &&
              (arcadeMemoryMatch(o,n)
                || (a.deck[a.firstCard] != a.deck[b.lastMove]
                  && b.secondCard == b.lastMove && b.moveCount == a.moveCount+1
                  && b.diff(a).affectedKeys().hasOnly(['secondCard','lastMove','moveCount']) && n.status == 'playing'))))));
    }
    function arcadeMove(o,n) {
      return o.status == 'playing' && o.state.winner == 0 && notBlocked(o)
        && request.auth.uid == (o.state.turn == 1 ? o.player1Id : o.player2Id)
        && n.diff(o).affectedKeys().hasOnly(['state','status','updatedAt','wins1','wins2']) && arcadeSeriesAward(o,n)
        && (o.gameType == 'memory' ? arcadeMemoryMove(o,n) : (o.gameType == 'checkers' ? checkersMove(o,n) : arcadeBoardMove(o,n)));
    }
    function arcadeOtherAction(o,n) {
      let me = request.auth.uid == o.player1Id ? 1 : 2;
      return (o.status in ['waiting','invited'] && request.auth.uid == o.player1Id
          && n.status == 'cancelled' && n.diff(o).affectedKeys().hasOnly(['status','updatedAt']))
        || (o.status == 'invited' && request.auth.uid == o.player2Id
          && (n.status == 'declined' || (n.status == 'playing' && notBlocked(o)))
          && n.diff(o).affectedKeys().hasOnly(['status','updatedAt']))
        || (o.status == 'playing' && n.status == 'finished' && n.state.winner is int && n.state.winner == 3-me
          && n.state.diff(o.state).affectedKeys().hasOnly(['winner']) && n.diff(o).affectedKeys().hasOnly(['state','status','updatedAt','wins1','wins2']) && arcadeSeriesAward(o,n))
        || (o.status == 'finished' && n.status == 'finished' && n.rematchRequestedBy == request.auth.uid
          && o.rematchRequestedBy in ['',request.auth.uid] && n.diff(o).affectedKeys().hasOnly(['rematchRequestedBy','updatedAt']))
        || (o.status == 'finished' && o.rematchRequestedBy != '' && o.rematchRequestedBy != request.auth.uid && notBlocked(o)
          && n.status == 'playing' && n.rematchRequestedBy == '' && n.round == o.round+1 && arcadeShape(n) && arcadeInitial(n)
          && arcadeSeriesNext(o,n) && n.diff(o).affectedKeys().hasOnly(['status','state','round','rematchRequestedBy','updatedAt','wins1','wins2','seriesRound']));
    }
    match /arcadeRooms/{id} {
      allow read: if signedIn() && (request.auth.uid in resource.data.participants || (resource.data.mode == 'random' && resource.data.status == 'waiting'));
      allow create: if signedIn() && arcadeShape(request.resource.data) && arcadeInitial(request.resource.data)
        && request.resource.data.player1Id == request.auth.uid && request.resource.data.round == 1 && request.resource.data.rematchRequestedBy == ''
        && request.resource.data.get('wins1',0) == 0 && request.resource.data.get('wins2',0) == 0 && request.resource.data.get('seriesRound',1) == 1
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time && request.resource.data.heartbeatAt == request.time
        && ((request.resource.data.mode == 'random' && request.resource.data.status == 'waiting'
            && request.resource.data.player2Id == '' && request.resource.data.player2Name == '' && request.resource.data.connectionId == ''
            && request.resource.data.participants == [request.auth.uid])
          || (request.resource.data.mode == 'invite' && request.resource.data.status == 'invited'
            && request.resource.data.player2Id != '' && request.resource.data.player2Id != request.auth.uid && request.resource.data.player2Name.size() >= 1
            && request.resource.data.participants == [request.auth.uid,request.resource.data.player2Id] && arcadeInvite(request.resource.data)));
      // Each branch validates its changed fields and freezes all other fields.
      // Avoid re-evaluating immutable room metadata on every move.
      allow update: if signedIn() && (
        (request.auth.uid in resource.data.participants && request.resource.data.updatedAt == request.time
          && (arcadeMove(resource.data,request.resource.data) || arcadeOtherAction(resource.data,request.resource.data)))
        || (resource.data.mode == 'random' && resource.data.status == 'waiting' && resource.data.player2Id == ''
          && request.auth.uid != resource.data.player1Id && resource.data.heartbeatAt >= request.time-duration.value(90,'s')
          && request.resource.data.status == 'playing' && request.resource.data.player2Id == request.auth.uid
          && request.resource.data.player2Name is string && request.resource.data.player2Name.size() >= 1 && request.resource.data.player2Name.size() <= 80
          && request.resource.data.participants == [resource.data.player1Id,request.auth.uid] && notBlocked(request.resource.data)
          && request.resource.data.updatedAt == request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','player2Id','player2Name','participants','updatedAt']))
        || (resource.data.status == 'waiting' && resource.data.player1Id == request.auth.uid
          && request.resource.data.heartbeatAt == request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['heartbeatAt']))
      );
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }
    match /arcadeRooms/{id}/messages/{messageId} {
      allow read: if arcadeMember(id);
      allow create: if arcadeMember(id) && arcadeRoom(id).status in ['playing','finished'] && notBlocked(arcadeRoom(id))
        && request.resource.data.keys().hasOnly(['senderId','senderName','text','createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string && request.resource.data.senderName.size() >= 1 && request.resource.data.senderName.size() <= 80
        && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if arcadeMember(id);
    }

    // Community upgrade: private date polls, opt-in discovery alerts and public replies.
    function acceptedConnection(id) {
      let c = connection(id);
      return signedIn() && request.auth.uid in c.participants && c.status == 'accepted' && notBlocked(c);
    }
    function pollMember(id) {
      let p = get(/databases/$(database)/documents/meetingPolls/$(id)).data;
      return signedIn() && request.auth.uid in p.participants && acceptedConnection(p.connectionId);
    }
    function validPollSlot(value) {
      return value is string && value.size() >= 20 && value.size() <= 30
        && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{3})?Z');
    }
    match /meetingPolls/{pollId} {
      allow read: if acceptedConnection(resource.data.connectionId);
      allow create: if signedIn() && acceptedConnection(request.resource.data.connectionId)
        && request.resource.data.keys().hasOnly(['connectionId','participants','creatorId','activity','place','options','status','selectedSlot','createdAt','updatedAt'])
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.participants == connection(request.resource.data.connectionId).participants
        && request.resource.data.activity is string && request.resource.data.activity.size() >= 2 && request.resource.data.activity.size() <= 120
        && request.resource.data.place is string && request.resource.data.place.size() >= 2 && request.resource.data.place.size() <= 160
        && request.resource.data.options is list && request.resource.data.options.size() >= 1 && request.resource.data.options.size() <= 3
        && validPollSlot(request.resource.data.options[0])
        && (request.resource.data.options.size() < 2 || validPollSlot(request.resource.data.options[1]))
        && (request.resource.data.options.size() < 3 || validPollSlot(request.resource.data.options[2]))
        && request.resource.data.options.toSet().size() == request.resource.data.options.size()
        && request.resource.data.status == 'open' && request.resource.data.selectedSlot == -1
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if pollMember(pollId) && resource.data.creatorId == request.auth.uid
        && resource.data.status == 'open' && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','selectedSlot','updatedAt'])
        && ((request.resource.data.status == 'cancelled' && request.resource.data.selectedSlot == -1)
          || (request.resource.data.status == 'confirmed'
            && request.resource.data.selectedSlot is int && request.resource.data.selectedSlot >= 0 && request.resource.data.selectedSlot < resource.data.options.size()
            && request.resource.data.selectedSlot in get(/databases/$(database)/documents/meetingPolls/$(pollId)/votes/$(resource.data.participants[0])).data.choices
            && request.resource.data.selectedSlot in get(/databases/$(database)/documents/meetingPolls/$(pollId)/votes/$(resource.data.participants[1])).data.choices));
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }
    match /meetingPolls/{pollId}/votes/{uid} {
      allow read: if pollMember(pollId);
      allow create, update: if owner(uid) && pollMember(pollId)
        && get(/databases/$(database)/documents/meetingPolls/$(pollId)).data.status == 'open'
        && request.resource.data.keys().hasOnly(['userId','choices','updatedAt'])
        && request.resource.data.userId == uid && request.resource.data.updatedAt == request.time
        && request.resource.data.choices is list && request.resource.data.choices.size() <= 3
        && request.resource.data.choices.toSet().size() == request.resource.data.choices.size()
        && request.resource.data.choices.hasOnly([0,1,2])
        && (get(/databases/$(database)/documents/meetingPolls/$(pollId)).data.options.size() >= 3 || !request.resource.data.choices.hasAny([2]))
        && (get(/databases/$(database)/documents/meetingPolls/$(pollId)).data.options.size() >= 2 || !request.resource.data.choices.hasAny([1]));
      allow delete: if owner(uid);
    }
    match /discoveryAlerts/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['userId','enabled','city','language','interest','seenIds','createdAt','updatedAt'])
        && request.resource.data.userId == uid && request.resource.data.enabled is bool
        && request.resource.data.city is string && request.resource.data.city.size() <= 80
        && request.resource.data.language is string && request.resource.data.language.size() <= 80
        && request.resource.data.interest is string && request.resource.data.interest.size() <= 80
        && request.resource.data.seenIds is list && request.resource.data.seenIds.size() <= 250
        && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt == request.time;
    }
    match /forumPosts/{postId}/replies/{replyId} {
      allow read: if (get(/databases/$(database)/documents/forumPosts/$(postId)).data.status == 'visible' && resource.data.status == 'visible') || moderator();
      allow create: if signedIn() && adultCommunityMember(request.auth.uid)
        && get(/databases/$(database)/documents/forumPosts/$(postId)).data.status == 'visible'
        && request.resource.data.keys().hasOnly(['authorId','authorName','text','status','adultConfirmed','createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string && request.resource.data.authorName.size() >= 1 && request.resource.data.authorName.size() <= 50
        && request.resource.data.text is string && request.resource.data.text.size() >= 2 && request.resource.data.text.size() <= 1200
        && request.resource.data.adultConfirmed == true && request.resource.data.status == 'visible' && request.resource.data.createdAt == request.time;
      allow update: if moderator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['visible','hidden','removed'];
      allow delete: if moderator() || (signedIn() && resource.data.authorId == request.auth.uid);
    }

  }
}