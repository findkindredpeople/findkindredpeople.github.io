rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function moderator() { return signedIn() && exists(/databases/$(database)/documents/moderators/$(request.auth.uid)); }
    function participant(data) { return signedIn() && request.auth.uid in data.participants; }
    function validProfile() {
      return request.resource.data.keys().hasOnly(['displayName','city','country','bio','interests','languages','availability','friendshipGoal','connectionMode','contactFrequency','socialFormat','communicationStyle','socialEnergy','spontaneousInvites','conversationDepth','newCityRole','timeZone','meetingPace','availableTimes','intercultural','namePronunciation','preferredContactTime','comfortableTopics','culturalContext','photoURL','zodiacSign','active','adultConfirmed','updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 50
        && request.resource.data.city is string && request.resource.data.city.size() >= 2 && request.resource.data.city.size() <= 80
        && request.resource.data.country is string && request.resource.data.country.size() >= 2 && request.resource.data.country.size() <= 80
        && request.resource.data.bio is string && request.resource.data.bio.size() >= 30 && request.resource.data.bio.size() <= 500
        && request.resource.data.interests is list && request.resource.data.interests.size() <= 12
        && request.resource.data.languages is list && request.resource.data.languages.size() <= 8
        && request.resource.data.friendshipGoal in ['close','casual','activities']
        && request.resource.data.connectionMode in ['online','offline','both']
        && request.resource.data.contactFrequency in ['daily','fewWeekly','weekly','flexible']
        && request.resource.data.socialFormat in ['one','small','both']
        && request.resource.data.communicationStyle in ['text','voice','calls','mixed']
        && request.resource.data.socialEnergy in ['calm','balanced','lively']
        && request.resource.data.spontaneousInvites in ['yes','no','sometimes']
        && request.resource.data.conversationDepth in ['deep','light','both']
        && request.resource.data.newCityRole in ['newcomer','localHelper','either']
        && request.resource.data.timeZone is string && request.resource.data.timeZone.size() <= 80
        && request.resource.data.meetingPace in ['soon','later','flexible','travel','onlineOnly']
        && request.resource.data.availableTimes is list && request.resource.data.availableTimes.size() >= 0 && request.resource.data.availableTimes.size() <= 6
        && request.resource.data.availableTimes.hasOnly(['weekdayMorning','weekdayDaytime','weekdayEvening','weekendMorning','weekendDaytime','weekendEvening','weekdaymorning','weekdaydaytime','weekdayevening','weekendmorning','weekenddaytime','weekendevening'])
        && request.resource.data.intercultural is bool
        && request.resource.data.get('namePronunciation', '') is string && request.resource.data.get('namePronunciation', '').size() <= 100
        && request.resource.data.get('preferredContactTime', 'flexible') in ['morning','afternoon','evening','flexible']
        && request.resource.data.get('comfortableTopics', []) is list && request.resource.data.get('comfortableTopics', []).size() <= 10
        && request.resource.data.get('culturalContext', '') is string && request.resource.data.get('culturalContext', '').size() <= 300
        && request.resource.data.get('zodiacSign', '') is string
        && request.resource.data.get('zodiacSign', '') in ['', 'aries','taurus','gemini','cancer','leo','virgo','libra','scorpio','sagittarius','capricorn','aquarius','pisces']
        && request.resource.data.active is bool && request.resource.data.adultConfirmed == true;
    }
    function validAgreement(data) {
      return data is map
        && data.keys().hasOnly(['frequency','meeting','format','closeness','voice','spontaneous','boundaries','updatedAt'])
        && data.frequency in ['daily','fewWeekly','weekly','flexible']
        && data.meeting in ['yes','maybe','onlineOnly']
        && data.format in ['text','voice','calls','mixed']
        && data.closeness in ['close','casual','open']
        && data.voice in ['yes','no']
        && data.spontaneous in ['yes','no','sometimes']
        && data.get('boundaries', '') is string
        && data.get('boundaries', '').size() <= 300;
    }
    function validJourney(data) {
      return data is map
        && data.keys().hasOnly(['steps','continueFriendship','updatedAt'])
        && data.steps is list && data.steps.size() == 4
        && data.steps[0] is bool && data.steps[1] is bool
        && data.steps[2] is bool && data.steps[3] is bool
        && (data.continueFriendship == null || data.continueFriendship is bool);
    }
    function validMeetingPlan(data) {
      return data is map
        && data.keys().hasOnly(['mode','activity','when','publicPlace','statusBy'])
        && data.mode in ['online','offline']
        && data.activity is string && data.activity.size() >= 1 && data.activity.size() <= 200
        && data.when is string && data.when.size() >= 10 && data.when.size() <= 50
        && data.publicPlace is string && data.publicPlace.size() <= 160
        && (data.mode == 'online' || data.publicPlace.size() >= 2)
        && data.statusBy is map
        && data.statusBy.keys().hasOnly([request.auth.uid])
        && data.statusBy[request.auth.uid] == 'accepted';
    }
    function validVideoCall(data) {
      return data is map
        && data.keys().hasOnly(['roomUrl','status','createdBy','respondedBy','respondedAt'])
        && data.roomUrl is string
        && data.roomUrl.matches('https://meet\\.jit\\.si/kindred-[A-Za-z0-9-]{20,80}')
        && data.status == 'ringing'
        && data.createdBy == request.auth.uid
        && data.respondedBy == '' && data.respondedAt == '';
    }
    function connection(id) { return get(/databases/$(database)/documents/connections/$(id)).data; }
    function notBlocked(data) {
      return !exists(/databases/$(database)/documents/blocks/$(data.participants[0] + '_' + data.participants[1]))
        && !exists(/databases/$(database)/documents/blocks/$(data.participants[1] + '_' + data.participants[0]));
    }
    function validGroup(data) {
      return data is map
        && data.keys().hasOnly(['name','topic','description','ownerId','ownerName','memberIds','invitedIds','createdAt','updatedAt','deleting'])
        && data.name is string && data.name.size() >= 3 && data.name.size() <= 60
        && data.topic is string && data.topic.size() >= 2 && data.topic.size() <= 40
        && data.description is string && data.description.size() >= 20 && data.description.size() <= 500
        && data.ownerId is string && data.ownerId.size() >= 1
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 80
        && data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 100
        && data.invitedIds is list && data.invitedIds.size() <= 100
        && data.ownerId in data.memberIds
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.get('deleting', false) is bool;
    }
    function groupDocument(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }
    function validPostData(data) {
      return data is map
        && data.keys().hasOnly(['authorId','authorName','authorPhotoUrl','text','photoUrl','musicLink','createdAt','visibility','viewerIds'])
        && data.authorId == request.auth.uid
        && data.authorName is string
        && data.authorName.size() >= 1
        && data.authorName.size() <= 80
        && data.get('authorPhotoUrl', '') is string
        && data.get('authorPhotoUrl', '').size() <= 250000
        && data.text is string
        && data.text.size() <= 2000
        && data.photoUrl is string
        && data.photoUrl.size() <= 250000
        && data.musicLink is string
        && data.musicLink.size() <= 1000
        && data.createdAt is int
        && data.get('visibility', 'all') in ['all','connections','only_me']
        && data.get('viewerIds', []) is list
        && data.get('viewerIds', []).size() <= 100
        && (data.text.size() >= 1 || data.photoUrl.size() >= 1 || data.musicLink.size() >= 1);
    }
    function limitedPostDocument(postId) {
      return get(/databases/$(database)/documents/limitedPosts/$(postId)).data;
    }
    function canReadLimitedPost(postId) {
      return signedIn()
        && (limitedPostDocument(postId).authorId == request.auth.uid
          || request.auth.uid in limitedPostDocument(postId).viewerIds);
    }

    // Community helpers. The Android app has a verified profile flag, while
    // the web community can self-attest adult status on meetup writes.
    function adultProfile(uid) {
      return signedIn()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/profiles/$(uid))
        && get(/databases/$(database)/documents/profiles/$(uid)).data.adultConfirmed == true;
    }

    function adultCommunityMember(uid) {
      return signedIn()
        && request.auth.uid == uid
        && (adultProfile(uid)
          || request.resource.data.get('adultConfirmed', false) == true);
    }

    function meetupExists(meetupId) {
      return exists(/databases/$(database)/documents/meetups/$(meetupId));
    }

    function meetupPublic(meetupId) {
      return meetupExists(meetupId)
        && get(/databases/$(database)/documents/meetups/$(meetupId)).data.status in ['visible','cancelled'];
    }

    function meetupHost(meetupId) {
      return signedIn()
        && meetupExists(meetupId)
        && get(/databases/$(database)/documents/meetups/$(meetupId)).data.creatorId == request.auth.uid;
    }

    function meetupParticipant(meetupId) {
      return signedIn()
        && (meetupHost(meetupId)
          || exists(/databases/$(database)/documents/meetups/$(meetupId)/interested/$(request.auth.uid)));
    }

    match /users/{uid} { allow read, create, update, delete: if owner(uid); }
    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['online','lastSeen'])
        && request.resource.data.online is bool;
      allow delete: if owner(uid);
    }
    match /presenceSessions/{presenceId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','sessionId','online','lastSeen'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() >= 16
        && request.resource.data.sessionId.size() <= 80
        && presenceId == request.auth.uid + '_' + request.resource.data.sessionId
        && request.resource.data.online is bool
        && request.resource.data.lastSeen is timestamp
        && request.resource.data.lastSeen == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if owner(uid) && validProfile();
      allow delete: if owner(uid);
    }
    match /connections/{id} {
      allow read: if participant(resource.data);
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['participants','requestedBy','recipientId','status','createdAt','updatedAt'])
        && request.resource.data.participants is list && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.recipientId in request.resource.data.participants
        && (id == request.auth.uid + '_' + request.resource.data.recipientId || id == request.resource.data.recipientId + '_' + request.auth.uid)
        && request.resource.data.status == 'pending';
      allow update: if (signedIn() && request.auth.uid == resource.data.recipientId
        && resource.data.status == 'pending' && request.resource.data.status in ['accepted','declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']))
        || (participant(resource.data) && resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['agreements','updatedAt'])
        && validAgreement(request.resource.data.agreements[request.auth.uid])
        && request.resource.data.agreements.diff(resource.data.get('agreements', {})).affectedKeys().hasOnly([request.auth.uid]))
        || (participant(resource.data) && resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['journeys','updatedAt'])
        && validJourney(request.resource.data.journeys[request.auth.uid])
        && request.resource.data.journeys.diff(resource.data.get('journeys', {})).affectedKeys().hasOnly([request.auth.uid]))
        || (participant(resource.data) && resource.data.status == 'accepted'
        && request.resource.data.status == 'removed'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']));
      allow delete: if participant(resource.data);
    }
    match /connections/{connectionId}/messages/{messageId} {
      allow read: if participant(connection(connectionId));
      allow create: if participant(connection(connectionId)) && connection(connectionId).status == 'accepted'
        && notBlocked(connection(connectionId))
        && request.resource.data.senderId == request.auth.uid
        && (
          (request.resource.data.keys().hasOnly(['senderId','text','type','audioUrl','durationMillis','createdAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 1
            && request.resource.data.text.size() <= 2000
            && request.resource.data.type == 'text'
            && request.resource.data.audioUrl == ''
            && request.resource.data.durationMillis == 0)
          ||
          (connection(connectionId).agreements is map
            && connection(connectionId).agreements.keys().hasAll(connection(connectionId).participants)
            && request.resource.data.keys().hasOnly(['senderId','text','audioData','audioType','duration','plan','call','createdAt'])
            && request.resource.data.get('text', '') is string
            && ((request.resource.data.get('text', '').size() >= 1 && request.resource.data.get('text', '').size() <= 2000 && request.resource.data.get('audioData', '') == '' && request.resource.data.get('plan', null) == null && request.resource.data.get('call', null) == null)
              || (request.resource.data.get('text', '') == ''
                && request.resource.data.get('audioData', '') is string && request.resource.data.get('audioData', '').size() >= 1 && request.resource.data.get('audioData', '').size() <= 180000
                && request.resource.data.get('audioData', '').matches('data:audio/(webm|mp4|ogg).*;base64,.*')
                && request.resource.data.get('audioType', '') is string && request.resource.data.get('audioType', '').matches('audio/(webm|mp4|ogg).*')
                && request.resource.data.get('duration', 0) is number && request.resource.data.get('duration', 0) > 0 && request.resource.data.get('duration', 0) <= 20
                && request.resource.data.get('plan', null) == null && request.resource.data.get('call', null) == null)
              || (request.resource.data.get('text', '') == '' && request.resource.data.get('audioData', '') == ''
                && validMeetingPlan(request.resource.data.plan) && request.resource.data.get('call', null) == null)
              || (request.resource.data.get('text', '') == '' && request.resource.data.get('audioData', '') == ''
                && request.resource.data.get('plan', null) == null && validVideoCall(request.resource.data.call))))
        );
      allow update: if (participant(connection(connectionId)) && connection(connectionId).status == 'accepted'
        && resource.data.plan is map && request.auth.uid != resource.data.senderId
        && !(request.auth.uid in resource.data.plan.statusBy)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan'])
        && request.resource.data.plan.diff(resource.data.plan).affectedKeys().hasOnly(['statusBy'])
        && request.resource.data.plan.statusBy.diff(resource.data.plan.statusBy).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.plan.statusBy[request.auth.uid] in ['accepted','declined'])
        || (participant(connection(connectionId)) && connection(connectionId).status == 'accepted'
        && resource.data.call is map && resource.data.call.status == 'ringing'
        && request.auth.uid != resource.data.senderId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['call'])
        && request.resource.data.call.diff(resource.data.call).affectedKeys().hasOnly(['status','respondedBy','respondedAt'])
        && request.resource.data.call.status in ['accepted','declined','missed']
        && request.resource.data.call.respondedBy == request.auth.uid
        && request.resource.data.call.respondedAt is string
        && request.resource.data.call.respondedAt.size() >= 10 && request.resource.data.call.respondedAt.size() <= 50);
      // Either participant can remove this shared conversation during account cleanup.
      allow delete: if participant(connection(connectionId));
    }
    match /blocks/{id} {
      allow read: if signedIn() && (resource.data.blockerId == request.auth.uid || resource.data.blockedId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId != request.auth.uid
        && request.resource.data.keys().hasOnly(['blockerId','blockedId','createdAt'])
        && id == request.auth.uid + '_' + request.resource.data.blockedId;
      allow delete: if signedIn() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['reporterId','reportedId','reason','details','status','createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedId != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.details is string && request.resource.data.details.size() >= 20 && request.resource.data.details.size() <= 1000
        && request.resource.data.status == 'open';
      allow read: if moderator() || (signedIn() && resource.data.reporterId == request.auth.uid);
      allow update: if moderator();
      allow delete: if false;
    }
    // Kindred Games: two-player Durak rooms with an in-room text chat.
    // Game rooms contain no money, betting, prizes or purchasable outcomes.
    function gameRoom(roomId) {
      return get(/databases/$(database)/documents/gameRooms/$(roomId)).data;
    }
    function gameParticipant(roomId) {
      return signedIn() && request.auth.uid in gameRoom(roomId).participants;
    }
    function validGameShape(data) {
      return data is map
        && data.keys().hasOnly(['gameType','mode','status','player1Id','player1Name','player2Id','player2Name','participants','deck','hand1','hand2','trumpSuit','attackerId','defenderId','currentTurnId','phase','attackCards','defenseCards','roundLimit','discardedCount','winnerId','loserId','rematchRequestedBy','createdAt','updatedAt'])
        && data.gameType == 'durak'
        && data.mode in ['random','invite']
        && data.status in ['waiting','invited','playing','finished','declined','cancelled']
        && data.player1Id is string && data.player1Id.size() >= 1
        && data.player1Name is string && data.player1Name.size() >= 1 && data.player1Name.size() <= 80
        && data.player2Id is string
        && data.player2Name is string && data.player2Name.size() <= 80
        && data.participants is list && data.participants.size() >= 1 && data.participants.size() <= 2
        && data.player1Id in data.participants
        && data.deck is list && data.deck.size() <= 36
        && data.hand1 is list && data.hand1.size() <= 36
        && data.hand2 is list && data.hand2.size() <= 36
        && data.trumpSuit in ['', 'C','D','H','S']
        && data.attackerId is string && data.defenderId is string && data.currentTurnId is string
        && data.phase in ['waiting','attack','defend','throw','take_throw','finished']
        && data.attackCards is list && data.attackCards.size() <= 6
        && data.defenseCards is list && data.defenseCards.size() <= 6
        && data.roundLimit is int && data.roundLimit >= 0 && data.roundLimit <= 6
        && data.discardedCount is int && data.discardedCount >= 0 && data.discardedCount <= 36
        && data.winnerId is string && data.loserId is string && data.rematchRequestedBy is string
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /gameRooms/{roomId} {
      allow read: if signedIn()
        && (request.auth.uid in resource.data.participants
          || (resource.data.mode == 'random' && resource.data.status == 'waiting'));

      allow create: if signedIn()
        && validGameShape(request.resource.data)
        && request.resource.data.player1Id == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.mode == 'random'
              && request.resource.data.status == 'waiting'
              && request.resource.data.player2Id == ''
              && request.resource.data.participants.size() == 1)
          || (request.resource.data.mode == 'invite'
              && request.resource.data.status == 'invited'
              && request.resource.data.player2Id.size() >= 1
              && request.resource.data.player2Id != request.auth.uid
              && request.resource.data.player2Id in request.resource.data.participants
              && request.resource.data.participants.size() == 2));

      // Existing participants may advance the room state, but identities and
      // the original participant list cannot be rewritten. Firestore
      // transactions in the app handle turn conflicts atomically.
      allow update: if signedIn() && validGameShape(request.resource.data)
        && request.resource.data.updatedAt == request.time
        && (
          (request.auth.uid in resource.data.participants
            && request.resource.data.player1Id == resource.data.player1Id
            && request.resource.data.player1Name == resource.data.player1Name
            && request.resource.data.player2Id == resource.data.player2Id
            && request.resource.data.player2Name == resource.data.player2Name
            && request.resource.data.participants == resource.data.participants
            && request.resource.data.mode == resource.data.mode
            && request.resource.data.gameType == resource.data.gameType
            && request.resource.data.createdAt == resource.data.createdAt)
          ||
          // A signed-in user may claim one genuinely open random table once.
          (resource.data.mode == 'random'
            && resource.data.status == 'waiting'
            && resource.data.player2Id == ''
            && request.auth.uid != resource.data.player1Id
            && request.resource.data.player1Id == resource.data.player1Id
            && request.resource.data.player1Name == resource.data.player1Name
            && request.resource.data.player2Id == request.auth.uid
            && request.resource.data.player2Name.size() >= 1
            && request.resource.data.participants.size() == 2
            && resource.data.player1Id in request.resource.data.participants
            && request.auth.uid in request.resource.data.participants
            && request.resource.data.mode == 'random'
            && request.resource.data.gameType == 'durak'
            && request.resource.data.createdAt == resource.data.createdAt)
        );

      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
    }

    match /gameRooms/{roomId}/messages/{messageId} {
      allow read: if gameParticipant(roomId);
      allow create: if gameParticipant(roomId)
        && request.resource.data.keys().hasOnly(['senderId','senderName','text','createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() >= 1
        && request.resource.data.senderName.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if gameParticipant(roomId);
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validPostData(request.resource.data)
        && request.resource.data.get('visibility', 'all') == 'all'
        && request.resource.data.get('viewerIds', []).size() == 0;
      allow update: if false;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }
    match /posts/{postId}/likes/{likeId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && exists(/databases/$(database)/documents/posts/$(postId))
        && likeId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId','createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow delete: if signedIn()
        && (likeId == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid);
    }
    match /posts/{postId}/comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/posts/$(postId))
        && request.resource.data.keys().hasOnly(['authorId','authorName','text','createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.authorId == request.auth.uid
          || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid);
    }
    match /limitedPosts/{postId} {
      allow read: if signedIn()
        && (resource.data.authorId == request.auth.uid
          || request.auth.uid in resource.data.viewerIds);
      allow create: if signedIn()
        && validPostData(request.resource.data)
        && request.resource.data.visibility in ['connections','only_me']
        && request.resource.data.viewerIds.size() >= 1
        && request.auth.uid in request.resource.data.viewerIds
        && (request.resource.data.visibility != 'only_me'
          || request.resource.data.viewerIds.size() == 1);
      allow update: if false;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }
    match /limitedPosts/{postId}/likes/{likeId} {
      allow read: if canReadLimitedPost(postId);
      allow create, update: if canReadLimitedPost(postId)
        && likeId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId','createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow delete: if canReadLimitedPost(postId)
        && (likeId == request.auth.uid
          || limitedPostDocument(postId).authorId == request.auth.uid);
    }
    match /limitedPosts/{postId}/comments/{commentId} {
      allow read: if canReadLimitedPost(postId);
      allow create: if canReadLimitedPost(postId)
        && request.resource.data.keys().hasOnly(['authorId','authorName','text','createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if canReadLimitedPost(postId)
        && (resource.data.authorId == request.auth.uid
          || limitedPostDocument(postId).authorId == request.auth.uid);
    }
    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validGroup(request.resource.data)
        && request.resource.data.get('deleting', false) == false
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid;
      allow update: if signedIn()
        && resource.data.get('deleting', false) == false
        && request.resource.data.get('deleting', false) == false
        && validGroup(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (request.auth.uid == resource.data.ownerId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','topic','description','ownerName','memberIds','invitedIds','updatedAt']))
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds','updatedAt'])
            && (
              (!(request.auth.uid in resource.data.memberIds)
                && request.auth.uid in request.resource.data.memberIds
                && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
                && request.resource.data.memberIds.hasAll(resource.data.memberIds))
              ||
              (request.auth.uid in resource.data.memberIds
                && !(request.auth.uid in request.resource.data.memberIds)
                && request.auth.uid != resource.data.ownerId
                && resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1
                && resource.data.memberIds.hasAll(request.resource.data.memberIds))
            )
          )
          || (
            request.auth.uid in resource.data.invitedIds
            && !(request.auth.uid in request.resource.data.invitedIds)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds','invitedIds','updatedAt'])
            && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          )
          || (
            request.auth.uid in resource.data.invitedIds
            && !(request.auth.uid in request.resource.data.invitedIds)
            && request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invitedIds','updatedAt'])
          )
        );
