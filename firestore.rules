        || (signedIn() && resource.data.authorId == request.auth.uid);

      // Compatible with the current forum page (author/category/text/status/
      // createdAt) and with the extended city/country/adultConfirmed shape.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['authorId','authorName','category','country','city','text','status','adultConfirmed','createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 80
        && request.resource.data.category in ['New in Town','Friendship & Connection','Activities','Languages & Culture','Ask the Community','Looking for company','Parents']
        && request.resource.data.get('country', '') is string
        && request.resource.data.get('country', '').size() <= 60
        && request.resource.data.get('city', '') is string
        && request.resource.data.get('city', '').size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10
        && request.resource.data.text.size() <= 1200
        && request.resource.data.status == 'visible'
        && request.resource.data.get('adultConfirmed', true) == true
        && request.resource.data.createdAt is timestamp;

      allow update: if moderator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['visible','hidden','removed'];

      allow delete: if moderator()
        || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    match /forumReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterId','postId','replyId','reason','status','createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postId.size() >= 1
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5
        && request.resource.data.reason.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp;

      allow read: if moderator()
        || (signedIn() && resource.data.reporterId == request.auth.uid);

      allow update: if moderator()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['open','reviewed','dismissed'];

      allow delete: if false;
    }

