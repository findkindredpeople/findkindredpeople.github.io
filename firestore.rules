      // cannot receive messages or membership changes, including from old clients.
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && resource.data.get('deleting', false) == false
        && request.resource.data.deleting == true
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleting','updatedAt']);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    match /groups/{groupId}/messages/{messageId} {
      allow read: if signedIn() && request.auth.uid in groupDocument(groupId).memberIds;
      allow create: if signedIn()
        && groupDocument(groupId).get('deleting', false) == false
        && request.auth.uid in groupDocument(groupId).memberIds
        && request.resource.data.keys().hasOnly(['senderId','senderName','text','createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() >= 1
        && request.resource.data.senderName.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.senderId == request.auth.uid
