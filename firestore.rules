      allow read: if meetupPublic(meetupId) || moderator();

      allow create, update: if signedIn()
        && uid == request.auth.uid
        && adultCommunityMember(request.auth.uid)
        && meetupExists(meetupId)
        && get(/databases/$(database)/documents/meetups/$(meetupId)).data.status == 'visible'
        && request.resource.data.keys().hasOnly(['userId','userName','adultConfirmed','createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() >= 1
        && request.resource.data.userName.size() <= 80
        && request.resource.data.createdAt is timestamp;

      allow delete: if signedIn()
        && (uid == request.auth.uid || moderator());
    }

    match /meetups/{meetupId}/messages/{messageId} {
